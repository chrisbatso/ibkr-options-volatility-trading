# Market Watcher configuration
# This file is a template of how .env file should look like

# Polling interval in seconds. Each cycle fetches a quote for every target stock,
# so keep this at 60 or more to stay clear of Yahoo Finance rate limits. 
UPDATE_TIMEOUT=60

# Which notifiers to start (true/false). Both are enabled when unset.
EMAIL_NOTIFIER_ENABLED=true
SLACK_NOTIFIER_ENABLED=true

# Daily P&L (as a fraction, 0.02 == 2%) to trigger notification for Long straddle strategy
LONG_THRESHOLD=0.02

# Daily P&L (as a fraction, 0.02 == 2%) to trigger notification for Short straddle strategy
SHORT_THRESHOLD=0.005

# Email and SMTP configuration (example for Gmail)
SMTP_HOSTNAME=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=mymail@gmail.com
SMTP_PASSWORD=password12345!

EMAIL_SENDER=sender@gmail.com
EMAIL_RECIPIENTS=user1@gmail.com;user2@gmail.com

# Configure Slack app: https://api.slack.com/messaging/webhooks
# Webhook link for channel where to post long straddle opportunities
SLACK_LONG_WEBHOOK=https://hooks.slack.com/services/example-webhook-link

# Webhook link for channel where to post short straddle opportunities
SLACK_SHORT_WEBHOOK=https://hooks.slack.com/services/example-webhook-link

