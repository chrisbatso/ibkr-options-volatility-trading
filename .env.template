# Market Watcher configuration
# This file is a template of how .env file should look like

# Polling interval in seconds. Each cycle fetches a quote for every target stock,
# so keep this at 60 or more to stay clear of Yahoo Finance rate limits. 
UPDATE_TIMEOUT=60

# Which notifiers to start (true/false). Both are enabled when unset.
EMAIL_NOTIFIER_ENABLED=true
SLACK_NOTIFIER_ENABLED=true

# Source of the daily P&L figures. Available: yahoo (Yahoo Finance), ibkr (Interactive Brokers)
MARKET_DATA_PROVIDER=yahoo

# Interactive Brokers settings (MARKET_DATA_PROVIDER=ibkr; needs `pip install "market_watcher[ibkr]"`).
# Ports: 7497 TWS paper, 7496 TWS live, 4002 IB Gateway paper, 4001 IB Gateway live.
# From Docker use IBKR_HOST=host.docker.internal and allow that address in the TWS API settings.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# 3 = delayed data where you have no live subscription (default), 1 = live data only
IBKR_MARKET_DATA_TYPE=3
# Seconds to wait for the connection and for each snapshot request
IBKR_TIMEOUT=10

# Poll only during the NYSE regular session (09:30-16:00 New York time on weekdays, minus
# holidays and after 13:00 on early-close days). Set to false to poll around the clock.
MARKET_HOURS_ENABLED=true

# Minutes after the open before short straddle alerts are considered: right after the open
# every stock shows a ~0% move, which would flood the short straddle channel.
SHORT_STRADDLE_WARMUP_MINUTES=30

# Extra full-day closures the built-in NYSE calendar cannot know about, e.g. a national day
# of mourning (comma-separated YYYY-MM-DD dates).
MARKET_HOLIDAYS=

# Daily P&L (as a fraction, 0.02 == 2%) to trigger notification for Long straddle strategy
LONG_THRESHOLD=0.02

# Daily P&L (as a fraction, 0.02 == 2%) to trigger notification for Short straddle strategy
SHORT_THRESHOLD=0.005

# Email and SMTP configuration (example for Gmail)
SMTP_HOSTNAME=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=mymail@gmail.com
SMTP_PASSWORD=password12345!

EMAIL_SENDER=sender@gmail.com
EMAIL_RECIPIENTS=user1@gmail.com;user2@gmail.com

# Configure Slack app: https://api.slack.com/messaging/webhooks
# Webhook link for channel where to post long straddle opportunities
SLACK_LONG_WEBHOOK=https://hooks.slack.com/services/example-webhook-link

# Webhook link for channel where to post short straddle opportunities
SLACK_SHORT_WEBHOOK=https://hooks.slack.com/services/example-webhook-link

# --- Automated order placement on IBKR (EXPERIMENTAL; off by default) -----------------------------
# When enabled, every new opportunity becomes one at-the-money straddle combo order on TWS, bought
# for a long straddle and sold for a short straddle. Needs `pip install "market_watcher[ibkr]"`,
# the TWS "Read-Only API" setting turned OFF, and the IBKR_HOST/IBKR_PORT settings above.
TRADING_ENABLED=false
# Build and log the orders without sending anything to TWS. Start here.
TRADING_DRY_RUN=false
# false = orders are staged in TWS and you click Transmit; true = transmitted automatically.
IBKR_TRANSMIT_ORDERS=false
# Orders are refused unless every account is a paper account (ids starting with DU).
TRADING_ALLOW_LIVE=false
# Strategies to trade. Short straddles are naked options with UNLIMITED risk and need margin
# approval; add them deliberately: TRADING_STRATEGIES=long straddle,short straddle
TRADING_STRATEGIES=long straddle
STRADDLE_CONTRACTS=1
# Caps: most a long straddle order may cost; most underlying notional (strike x 100 x contracts) a
# short straddle may carry; most new positions per trading day (also one per ticker per day).
STRADDLE_MAX_PREMIUM=1000
STRADDLE_MAX_NOTIONAL=20000
TRADING_MAX_ORDERS_PER_DAY=3
# Nearest expiry at least this many days out; limit price = net mid +/- this percentage.
STRADDLE_MIN_DAYS_TO_EXPIRY=7
STRADDLE_LIMIT_BUFFER_PCT=2
# Client id of the trading connection (the data provider uses IBKR_CLIENT_ID).
IBKR_TRADING_CLIENT_ID=2
# Position management, checked on every polling cycle while the market is open. Close a straddle
# once its value has moved this far from the entry price (0 disables a rule) ...
TRADING_TAKE_PROFIT_PCT=50
TRADING_STOP_LOSS_PCT=50
# ... and this many minutes before the session close, unless positions are held overnight.
TRADING_EXIT_MINUTES_BEFORE_CLOSE=15
TRADING_HOLD_OVERNIGHT=false
# Never hold more than this many straddles; once the day's realized plus unrealized loss reaches
# this amount (USD; 0 disables) everything is closed and no new positions are opened that day.
TRADING_MAX_OPEN_POSITIONS=3
TRADING_MAX_DAILY_LOSS=500
# Size long straddles by premium at risk: contracts = min(STRADDLE_CONTRACTS, risk / premium per
# contract). 0 = always STRADDLE_CONTRACTS.
STRADDLE_RISK_PER_TRADE=0
